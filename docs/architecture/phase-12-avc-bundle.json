    {
      "id": "resolve-user-scope-hit",
      "version": 1,
      "verifies": ["Phase 12 Section 12.1 — Resolution Algorithm Step 3 (user scope search)"],
      "description": "Term found in user scope returns status='resolved' with user scope metadata. No global scope search occurs.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              { "id": "user:dog", "canonicalLabel": "dog", "parent": "user:mammal" },
              { "id": "user:mammal", "canonicalLabel": "mammal", "parent": null }
            ]
          },
          {
            "scopeType": "global",
            "graphId": "global-cco",
            "priority": 1,
            "graphVersion": "1.4.0",
            "concepts": [
              { "id": "cco:dog", "canonicalLabel": "dog", "parent": "cco:canine" }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": { "type": "resolveTerm", "value": "dog" },
      "expect": {
        "resolution": {
          "status": "resolved",
          "sourceScope": "user-graph-a",
          "sourceScopeType": "user"
        },
        "globalScopesSearched": false,
        "copiedConcept": {
          "canonicalLabel": "dog",
          "annotations": {
            "fandaws:resolvedFrom": {
              "graphId": "user-graph-a",
              "conceptIri": "user:dog",
              "scopeType": "user",
              "resolvedAt": "ANY_ISO_DATETIME",
              "graphVersion": "1.0.0"
            }
          }
        }
      },
      "negative_assertions": [
        { "condition": "no global scope fallthrough", "description": "Global scope MUST NOT be searched when user scope produces a match." }
      ]
    },
