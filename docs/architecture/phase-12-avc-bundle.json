    {
      "id": "compat-prefix-match",
      "version": 1,
      "verifies": ["Phase 12 Decision 1 — Prefix Match (compatible)"],
      "description": "Local chain 'dog → mammal' and global chain 'dog → mammal → animal'. Local is prefix of global. Auto-resolves, upgrades local chain to include 'animal'.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              { "id": "user:dog", "canonicalLabel": "dog", "parent": "user:mammal" },
              { "id": "user:mammal", "canonicalLabel": "mammal", "parent": null }
            ]
          },
          {
            "scopeType": "global",
            "graphId": "global-cco",
            "priority": 1,
            "graphVersion": "1.4.0",
            "concepts": [
              { "id": "cco:dog", "canonicalLabel": "dog", "parent": "cco:mammal" },
              { "id": "cco:mammal", "canonicalLabel": "mammal", "parent": "cco:animal" },
              { "id": "cco:animal", "canonicalLabel": "animal", "parent": null }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": { "type": "resolveTerm", "value": "dog" },
      "expect": {
        "resolution": { "status": "resolved", "compatibilityCase": "prefix_match" },
        "postState": {
          "dog": { "skos:broader": "mammal" },
          "mammal": { "skos:broader": "animal" },
          "animal": { "skos:broader": null }
        }
      },
      "negative_assertions": [
        { "condition": "no conflict prompt", "description": "System MUST NOT fire a conflict prompt for prefix-match compatibility." }
      ]
    },
    {
      "id": "compat-transitive-match",
      "version": 1,
      "verifies": ["Phase 12 Decision 1 — Transitive Path Compatibility (silent upgrade)"],
      "description": "Local chain 'dog → mammal' and global chain 'dog → canine → mammal'. Global is transitive refinement of local. System silently upgrades: dog's direct parent becomes canine, canine's parent is mammal. The direct dog→mammal edge is REMOVED.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              { "id": "user:dog", "canonicalLabel": "dog", "parent": "user:mammal" },
              { "id": "user:mammal", "canonicalLabel": "mammal", "parent": null }
            ]
          },
          {
            "scopeType": "global",
            "graphId": "global-cco",
            "priority": 1,
            "graphVersion": "1.4.0",
            "concepts": [
              { "id": "cco:dog", "canonicalLabel": "dog", "parent": "cco:canine" },
              { "id": "cco:canine", "canonicalLabel": "canine", "parent": "cco:mammal" },
              { "id": "cco:mammal", "canonicalLabel": "mammal", "parent": null }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": { "type": "resolveTerm", "value": "dog" },
      "expect": {
        "resolution": { "status": "resolved", "compatibilityCase": "transitive_match" },
        "postState": {
          "dog": { "skos:broader": "canine" },
          "canine": { "skos:broader": "mammal" },
          "mammal": { "skos:broader": null }
        },
        "removedEdges": [
          { "subject": "dog", "predicate": "skos:broader", "object": "mammal", "reason": "replaced by transitive closure dog → canine → mammal" }
        ]
      },
      "negative_assertions": [
        { "condition": "no conflict prompt", "description": "System MUST NOT fire a conflict prompt — the local chain is a valid transitive closure of the global chain." },
        { "condition": "direct edge removed", "description": "The direct dog→mammal edge MUST be removed. Leaving both dog→canine and dog→mammal creates polyhierarchy, which violates single-inheritance commitment." }
      ]
    },
    {
      "id": "conflict-divergent-parent",
      "version": 1,
      "verifies": ["Phase 12 Decision 1 — Divergent chains (conflict)", "Phase 12 Section 12.1 — Conflict Detection"],
      "description": "Local 'dog → pet' and global 'dog → mammal'. Different parents, neither chain is transitive closure of the other. System fires conflict prompt.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
