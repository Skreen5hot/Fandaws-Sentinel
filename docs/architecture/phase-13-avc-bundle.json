    {
      "id": "ms-agent-mode-reclassification",
      "version": 1,
      "verifies": [
        "Phase 13 Section 13.1 \u2014 MachineSignal on reclassificationConsequence",
        "Decision A \u2014 Layered schema"
      ],
      "description": "In agent mode, a reclassification prompt carries a fully populated MachineSignal with common envelope fields plus reclassification-specific extension payload.",
      "setup": {
        "callerMode": "agent",
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              {
                "id": "user:organism",
                "canonicalLabel": "organism",
                "parent": "user:material-entity",
                "restrictions": [
                  {
                    "verb": "has",
                    "object": "user:dna"
                  }
                ]
              },
              {
                "id": "user:animal",
                "canonicalLabel": "animal",
                "parent": "user:organism"
              },
              {
                "id": "user:material-entity",
                "canonicalLabel": "material entity",
                "parent": null,
                "isImported": true
              },
              {
                "id": "user:dna",
                "canonicalLabel": "dna",
                "parent": null
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "utterance",
        "value": "an animal is a material entity"
      },
      "expect": {
        "prompt": {
          "fired": true,
          "machineSignal": {
            "envelope": {
              "promptType": "reclassificationConsequence",
              "constraintType": "subsumption",
              "options": [
                "keep_current",
                "reclassify_subtree",
                "reclassify_only"
              ],
              "expectedSchema": {
                "isValidJsonSchema": true,
                "describesResponseShape": {
                  "type": "object",
                  "requiredProperties": [
                    "choice"
                  ],
                  "choiceEnum": [
                    "keep_current",
                    "reclassify_subtree",
                    "reclassify_only"
                  ]
                }
              }
            },
            "extension": {
              "caseType": "weakening",
              "subject": "animal",
              "currentParent": "organism",
              "proposedParent": "material entity",
              "lostProperties": [
                {
                  "ancestor": "organism",
                  "property": "has dna",
                  "affectedDescendants": 0
                }
              ]
            }
          }
        }
      }
    },
