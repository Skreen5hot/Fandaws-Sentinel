      ]
    },

    {
      "id": "sim-multiturn-knowledge-building",
      "version": 1,
      "verifies": ["Phase 13 Section 13.3 — scripted agent multi-turn session"],
      "description": "Scripted agent completes a multi-turn knowledge building session. Asserts classification, receives MachineSignal, responds, mutation applied. Three-turn sequence.",
      "setup": {
        "callerMode": "agent",
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "agentScript",
        "turns": [
          { "utterance": "a dog is a mammal", "expectedPrompt": null, "expectedMutation": "classification" },
          { "utterance": "a cat is a mammal", "expectedPrompt": null, "expectedMutation": "classification" },
          { "utterance": "a dog chases a cat", "expectedPrompt": null, "expectedMutation": "relationship" }
        ]
      },
      "expect": {
        "allTurnsCompleted": true,
        "postState": {
          "dog": { "skos:broader": "ANY_IRI_MATCHING(mammal)" },
          "cat": { "skos:broader": "ANY_IRI_MATCHING(mammal)" },
          "dog_chases_cat": { "exists": true, "verb": "chase" }
        },
        "machineSignalOnEveryPrompt": true,
        "note": "Simple assertions with no disambiguation needed. No prompts expected. MachineSignal presence is verified only when prompts fire."
      }
    },

    {
      "id": "sim-agent-hits-deadlock-continues",
      "version": 1,
      "verifies": ["Phase 13 Section 13.3 — agent hits deadlock, session continues"],
      "description": "Agent builds some knowledge, then repeatedly asserts an impossible reclassification until deadlock. EpistemicFailure fires. Agent then successfully asserts an unrelated classification. Session is alive.",
      "setup": {
        "callerMode": "agent",
        "humanChannelAvailable": false,
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              { "id": "user:process", "canonicalLabel": "process", "parent": null, "isImported": true }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "agentScript",
        "turns": [
          { "utterance": "a dog is a mammal", "expectedPrompt": null, "expectedMutation": "classification" },
          { "utterance": "a dog is a process", "expectedPrompt": "reclassificationConsequence", "agentResponse": { "choice": "reclassify_subtree" }, "expectedOutcome": "rejected" },
          { "utterance": "a dog is a process", "expectedOutcome": "rejected" },
          { "utterance": "a dog is a process", "expectedOutcome": "rejected" },
          { "utterance": "a dog is a process", "expectedOutcome": "rejected" },
          { "utterance": "a dog is a process", "expectedOutcome": "deadlock_cascade" },
          { "utterance": "a cat is a feline", "expectedPrompt": null, "expectedMutation": "classification" }
        ]
      },
      "expect": {
        "allTurnsCompleted": true,
        "epistemicFailures": [
          { "concept": "dog", "mutationType": "reclassification" }
        ],
        "postState": {
          "dog": { "skos:broader": "ANY_IRI_MATCHING(mammal)", "note": "Still under mammal — reclassification never succeeded" },
          "cat": { "skos:broader": "ANY_IRI_MATCHING(feline)", "note": "Successfully classified after deadlock on different pair" }
        },
        "sessionActive": true
      }
    },

