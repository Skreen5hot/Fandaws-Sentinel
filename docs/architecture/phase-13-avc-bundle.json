    {
      "id": "rate-limit-exceeded",
      "version": 1,
      "verifies": ["Phase 13 Section 13.2 — rate limiting", "Decision F — per session, 100/min"],
      "description": "Agent exceeds 100 assertions in under 60 seconds. System returns RateLimitExceeded error with retryAfter field. Session paused, not terminated.",
      "setup": {
        "callerMode": "agent",
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "burstAssertions",
        "count": 101,
        "withinSeconds": 60
      },
      "expect": {
        "error": {
          "type": "RateLimitExceeded",
          "assertionCount": 101,
          "windowSeconds": 60,
          "limit": 100,
          "retryAfter": "ANY_POSITIVE_INTEGER",
          "retryAfterUnit": "seconds"
        },
        "sessionTerminated": false,
        "sessionPaused": true
      },
      "negative_assertions": [
        { "condition": "session not terminated", "description": "RateLimitExceeded pauses the session. It does NOT terminate it. After retryAfter seconds, the agent can resume." }
      ]
    },

    {
      "id": "rate-limit-not-exceeded-at-100",
      "version": 1,
      "verifies": ["Decision F — boundary: exactly 100 is within limit"],
      "description": "Exactly 100 assertions in 60 seconds is within the limit. No error. Assertion 101 within the same window triggers the error.",
