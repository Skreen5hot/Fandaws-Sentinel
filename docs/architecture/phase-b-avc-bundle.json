    {
      "id": "dl-restriction-compiled-to-execution",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Section 4.2 \u2014 What Is Generated (Execution Lane)"
      ],
      "description": "A property assertion ('dog has fur') produces an owl:Restriction in the Execution Lane. The restriction carries owl:onProperty and owl:someValuesFrom. The Canonical Lane stores the raw assertion.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              {
                "id": "user:dog",
                "canonicalLabel": "dog",
                "parent": null
              },
              {
                "id": "user:fur",
                "canonicalLabel": "fur",
                "parent": null
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "utterance",
        "value": "a dog has fur"
      },
      "expect": {
        "executionLane": {
          "containsRestriction": {
            "owlOnProperty": "fandaws:objectProperty/has",
            "owlSomeValuesFrom": "ANY_IRI_MATCHING(fur)",
            "onConcept": "ANY_IRI_MATCHING(dog)",
            "hasEpoch": true
          }
        }
      }
    },
    {
      "id": "disj-explicit-pairs-detected",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Rule CC-4 \u2014 Disjointness Map includes explicit pairs",
        "Q2 answer \u2014 parsed from Turtle"
      ],
      "description": "After BFO ingestion, the Disjointness Map contains the explicitly declared owl:disjointWith pairs from BFO 2020 (e.g., Continuant/Occurrent).",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "queryDisjointnessMap"
      },
      "expect": {
        "disjointnessMap": {
          "containsPair": [
            "Continuant",
            "Occurrent"
          ],
          "sourceType": "explicit",
          "note": "Continuant owl:disjointWith Occurrent is explicitly declared in BFO 2020 Turtle."
        }
      }
    },
    {
      "id": "disj-inferred-via-transitive-closure",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Rule CC-4 \u2014 inferred disjointness via transitive closure"
      ],
      "description": "MaterialEntity (under Continuant) and Process (under Occurrent) are disjoint by inference. They are NOT explicitly declared disjoint in BFO \u2014 their disjointness is inherited from Continuant/Occurrent. The map MUST contain this inferred pair.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "queryDisjointnessMap"
      },
      "expect": {
        "disjointnessMap": {
          "containsPair": [
            "MaterialEntity",
            "Process"
          ],
          "sourceType": "inferred",
          "inferenceChain": "MaterialEntity \u2192 IndependentContinuant \u2192 Continuant | Process \u2192 Occurrent; Continuant disjointWith Occurrent"
        }
      }
    },
    {
      "id": "disj-non-disjoint-not-in-map",
      "version": 1,
      "verifies": [
        "CC-4 negative \u2014 non-disjoint pairs absent"
      ],
      "description": "MaterialEntity and IndependentContinuant are NOT disjoint (MaterialEntity is a subclass of IndependentContinuant). The map MUST NOT contain this pair.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "queryDisjointnessMap"
      },
      "expect": {
        "disjointnessMap": {
          "doesNotContainPair": [
            "MaterialEntity",
            "IndependentContinuant"
          ]
        }
      },
      "negative_assertions": [
        {
          "condition": "ancestor-descendant is not disjoint",
          "description": "A class and its ancestor are NEVER disjoint. The map MUST NOT contain any ancestor-descendant pairs."
        }
      ]
    },
    {
      "id": "disj-sibling-under-same-parent-not-disjoint",
      "version": 2,
      "verifies": [
        "CC-4 precision \u2014 siblings not automatically disjoint"
      ],
      "description": "Siblinghood alone does NOT imply disjointness. Two user-created concepts (organism and tool) that are both children of MaterialEntity are siblings but have NO owl:disjointWith declaration anywhere. The Disjointness Map MUST NOT contain this pair. v2 fix: replaced Quality/RealizableEntity (which BFO 2020 explicitly declares disjoint) with user-created siblings.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": [
              {
                "id": "user:material-entity",
                "canonicalLabel": "material entity",
                "parent": null,
                "isImported": true,
                "equivalentClass": [
                  "bfo:BFO_0000040"
                ]
              },
              {
                "id": "user:organism",
                "canonicalLabel": "organism",
                "parent": "user:material-entity"
              },
              {
                "id": "user:tool",
                "canonicalLabel": "tool",
                "parent": "user:material-entity"
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "queryDisjointnessMap"
      },
      "expect": {
        "disjointnessMap": {
          "containsPair": [
            "MaterialEntity",
            "ImmaterialEntity"
          ],
          "doesNotContainPair": [
            "organism",
            "tool"
          ],
          "note": "MaterialEntity/ImmaterialEntity: explicitly disjoint in BFO 2020. organism/tool: user-created siblings under MaterialEntity with no disjointness declaration. Siblinghood alone is not disjointness."
        }
      },
      "negative_assertions": [
        {
          "condition": "user concepts never auto-disjoint",
          "description": "User-created concepts MUST NEVER appear in the Disjointness Map. The map contains only BFO node pairs (explicit + inferred). User concepts inherit their ancestor's BFO category for disjointness checking, but they themselves are not disjointness map entries."
        }
      ]
    },
    {
      "id": "disj-map-rebuilt-on-reingestion",
      "version": 1,
      "verifies": [
        "Q2 answer \u2014 rebuilt on re-ingestion"
      ],
      "description": "After BFO re-ingestion (e.g., updated Turtle file), the Disjointness Map is recomputed from scratch. Stale pairs from a hypothetical prior version do not persist.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "reingestion",
        "target": "bfo"
      },
      "expect": {
        "disjointnessMap": {
          "recomputed": true,
          "containsPair": [
            "Continuant",
            "Occurrent"
          ],
          "containsPair2": [
            "MaterialEntity",
            "Process"
          ],
          "note": "Map is freshly computed from the re-ingested Turtle. Not carried over from prior ingestion."
        }
      }
    },
    {
      "id": "cc-path-a-disjointness-fires",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Rule CC-1 \u2014 Path A fires on reclassification",
        "FANDAWS v2.1 Section 3.8.1"
      ],
      "description": "Reclassifying a concept causes an existing restriction to connect disjoint BFO types. The consequence prompt gains a third category: 'Restrictions that would become type-invalid.'",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": [
              {
                "id": "user:material-entity",
                "canonicalLabel": "material entity",
                "parent": null,
                "isImported": true
              },
              {
                "id": "user:process",
                "canonicalLabel": "process",
                "parent": null,
                "isImported": true
              },
              {
                "id": "user:dog",
                "canonicalLabel": "dog",
                "parent": "user:material-entity",
                "restrictions": [
                  {
                    "verb": "has",
                    "object": "user:fur"
                  }
                ]
              },
              {
                "id": "user:fur",
                "canonicalLabel": "fur",
                "parent": "user:material-entity"
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "utterance",
        "value": "fur is a process"
      },
      "expect": {
        "prompt": {
          "fired": true,
          "machineSignal": {
            "envelope": {
              "promptType": "reclassificationConsequence"
            },
            "extension": {
              "invalidRestrictions": [
                {
                  "subject": "dog",
                  "relation": "has",
                  "object": "fur",
                  "subjectBFO": "MaterialEntity",
                  "objectNewBFO": "Process",
                  "disjoint": true
                }
              ]
            }
          }
        },
        "mutation": "none_until_user_choice"
      }
    },
