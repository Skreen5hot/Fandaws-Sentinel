{
  "bundle_id": "phase-b-ontology-ingestion-dual-lane",
  "bundle_version": 2,
  "authored": "2026-04-16",
  "status": "awaits_implementation",
  "verifies_phase": "Phase B \u2014 Ontology Ingestion (FANDAWS v2.1 Roadmap Phase 2)",
  "locked_decisions": {
    "dual_lane": "Option (b): existing graph is Canonical Lane. compile() method produces Execution Lane as derived _executionLane Map on StateAdapter. Runs synchronously after every mutation. Export reads from Execution Lane.",
    "disjointness_map": "Parsed from ingested BFO Turtle owl:disjointWith triples. Transitive closure through rdfs:subClassOf chains. Computed once at ingestion, rebuilt on re-ingestion. NOT hardcoded.",
    "cc_path_a": "Third consequence category in buildReclassificationConsequencePrompt: 'Restrictions that would become type-invalid.' Fires on reclassification.",
    "cc_path_b": "Pre-commit gate at entry of processProperty and processRelationship. Fires BEFORE any restriction or relationship node is created. Not inside the workflow \u2014 before it.",
    "recc_scope": "Phase B: structural conformance as JavaScript index lookups only. No OWL restrictions in export. No provenance authority enforcement. Full RECC is Phase C.",
    "compilation_status": "Two-state only: Uncompiled and Compiled. Stale/Retracted states are Phase C.",
    "export_source": "Export reads from Execution Lane. Exclusion list pattern replaced. Metadata fields never enter Execution Lane.",
    "epoch": "Integer on every execution artifact. Increments per compile() pass. Trivially cheap.",
    "namespace": "Continue using fandaws: for everything. Namespace split (fan: vs fandaws:) deferred to Phase D."
  },
  "scenarios": [
    {
      "id": "dl-compile-produces-execution-lane",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Section 2.3 \u2014 Dual Representation",
        "Q1 answer \u2014 compile() after every mutation"
      ],
      "description": "After a classification mutation, the Execution Lane is populated with a compiled artifact. The Canonical Lane retains the raw assertion data. Both exist simultaneously.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              {
                "id": "user:mammal",
                "canonicalLabel": "mammal",
                "parent": null
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "utterance",
        "value": "a dog is a mammal"
      },
      "expect": {
        "canonicalLane": {
          "conceptExists": "dog",
          "skosBroader": "ANY_IRI_MATCHING(mammal)",
          "retainsMetadata": true,
          "note": "Canonical Lane holds the raw concept with skos:broader, provenance, metadata"
        },
        "executionLane": {
          "populated": true,
          "containsArtifactFor": "dog",
          "hasEpoch": true,
          "note": "Execution Lane holds compiled artifact produced by compile() pass"
        }
      }
    },
    {
      "id": "dl-compile-runs-after-every-mutation",
      "version": 1,
      "verifies": [
        "Q1 answer \u2014 compile() runs synchronously after every mutation"
      ],
      "description": "Two sequential mutations each trigger a compile pass. Execution Lane epoch increments twice. Each artifact carries its own epoch.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "agentScript",
        "turns": [
          {
            "utterance": "a dog is a mammal",
            "expectedMutation": "classification"
          },
          {
            "utterance": "a cat is a mammal",
            "expectedMutation": "classification"
          }
        ]
      },
      "expect": {
        "executionLane": {
          "artifactCount": "ANY_GTE(2)",
          "epochAfterTurn1": 1,
          "epochAfterTurn2": 2,
          "note": "Each mutation triggers compile(). Epoch increments each time."
        }
      }
    },
    {
      "id": "dl-execution-lane-no-metadata",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Section 4.5 \u2014 What Is Not Mixed",
        "Export source decision"
      ],
      "description": "Execution Lane artifacts do NOT contain canonical metadata fields (fandaws:isImported, fandaws:source, fandaws:ingestSource, fandaws:locallyModified, fandaws:normalizationStatus). These exist only in the Canonical Lane.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              {
                "id": "user:material-entity",
                "canonicalLabel": "material entity",
                "parent": null,
                "isImported": true,
                "equivalentClass": [
                  "bfo:BFO_0000040"
                ]
              },
              {
                "id": "user:organism",
                "canonicalLabel": "organism",
                "parent": "user:material-entity"
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "utterance",
        "value": "an animal is an organism"
      },
      "expect": {
        "executionLane": {
          "artifactFor": "animal",
          "doesNotContain": [
            "fandaws:isImported",
            "fandaws:source",
            "fandaws:ingestSource",
            "fandaws:locallyModified",
            "fandaws:normalizationStatus"
          ],
          "doesContain": [
            "rdfs:subClassOf",
            "fandaws:compilationEpoch"
          ]
        },
        "canonicalLane": {
          "conceptFor": "animal",
          "doesContain": [
            "skos:broader",
            "skos:prefLabel"
          ]
        }
      },
      "negative_assertions": [
        {
          "condition": "no metadata leakage",
          "description": "Execution Lane MUST NOT contain any fandaws: metadata fields. These belong exclusively in the Canonical Lane."
        }
      ]
    },
    {
      "id": "dl-canonical-lane-unchanged-by-compile",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Section 2.4 \u2014 Compiler Sovereignty"
      ],
      "description": "The compile() pass does not modify the Canonical Lane. It reads from canonical and writes to execution. The canonical graph is identical before and after compile().",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              {
                "id": "user:mammal",
                "canonicalLabel": "mammal",
                "parent": null
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "utterance",
        "value": "a dog is a mammal"
      },
      "expect": {
        "canonicalLane": {
          "conceptCount": 2,
          "noCompilerArtifacts": true,
          "note": "Canonical Lane has mammal + dog. No compilation epoch, no execution artifacts injected."
        }
      },
      "negative_assertions": [
        {
          "condition": "compiler does not write to canonical",
          "description": "fandaws:compilationEpoch MUST NOT appear on canonical concepts. It appears only on execution artifacts."
        }
      ]
    },
    {
      "id": "dl-export-reads-execution-lane",
      "version": 1,
      "verifies": [
        "Export source decision \u2014 Execution Lane replaces exclusion list"
      ],
      "description": "Turtle export reads from the Execution Lane. The exported output contains compiled restrictions and subclass declarations but no canonical metadata. The exclusion list filtering pattern is replaced.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              {
                "id": "user:material-entity",
                "canonicalLabel": "material entity",
                "parent": null,
                "isImported": true,
                "equivalentClass": [
                  "bfo:BFO_0000040"
                ]
              },
              {
                "id": "user:organism",
                "canonicalLabel": "organism",
                "parent": "user:material-entity",
                "restrictions": [
                  {
                    "verb": "has",
                    "object": "user:dna"
                  }
                ]
              },
              {
                "id": "user:animal",
                "canonicalLabel": "animal",
                "parent": "user:organism"
              },
              {
                "id": "user:dna",
                "canonicalLabel": "dna",
                "parent": null
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "export",
        "format": "turtle"
      },
      "expect": {
        "exportCheck": {
          "containsSubClassOf": true,
          "containsOwlRestriction": true,
          "containsOwlImports": true,
          "doesNotContain": [
            "fandaws:isImported",
            "fandaws:source",
            "fandaws:ingestSource",
            "fandaws:normalizationStatus",
            "fandaws:compilationStatus"
          ],
          "note": "Export is a serialization of the Execution Lane, not a filtered view of the Canonical Lane."
        }
      }
    },
    {
      "id": "dl-compilation-status-lifecycle",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Section 4.1.4 \u2014 compilationStatus",
        "Q6 answer \u2014 two-state only"
      ],
      "description": "New canonical record starts with compilationStatus=Uncompiled. After compile() runs, it transitions to Compiled. No Stale or Retracted states in Phase B.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              {
                "id": "user:mammal",
                "canonicalLabel": "mammal",
                "parent": null
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "utterance",
        "value": "a dog is a mammal"
      },
      "expect": {
        "canonicalLane": {
          "dog": {
            "compilationStatus": "Compiled",
            "note": "After mutation + compile(), status is Compiled. The Uncompiled state exists only transiently between mutation and compile()."
          }
        }
      },
      "negative_assertions": [
        {
          "condition": "no Stale or Retracted",
          "description": "compilationStatus MUST NOT be 'Stale' or 'Retracted' in Phase B. Those states require Phase C stale detection machinery."
        }
      ]
    },
    {
