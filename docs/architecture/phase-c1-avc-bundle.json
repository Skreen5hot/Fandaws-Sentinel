      "trigger": {
        "type": "utterance",
        "value": "a dog is an animal"
      },
      "expect": {
        "executionLane": {
          "staleArtifactCount": 0,
          "note": "After mutation + compile(), no Stale artifacts exist. The stale window was within the synchronous pass."
        }
      }
