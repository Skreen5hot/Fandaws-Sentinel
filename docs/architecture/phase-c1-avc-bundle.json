                "parent": null,
                "isImported": true
              },
              {
                "id": "user:dog",
                "canonicalLabel": "dog",
                "parent": "user:material-entity",
                "restrictions": [
                  {
                    "verb": "has",
                    "object": "user:running",
                    "compilationStatus": "CompilerRejected"
                  }
                ]
              },
              {
                "id": "user:running",
                "canonicalLabel": "running",
                "parent": "user:process"
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "utterance",
        "value": "running is a material entity"
      },
      "user_choice": {
        "action": "reclassify_subtree"
      },
      "expect": {
        "postState": {
          "running": {
            "skos:broader": "ANY_IRI_MATCHING(material-entity)"
          },
          "dogHasRunning": {
            "compilationStatus": "Compiled",
            "note": "After running moves to MaterialEntity, the restriction is no longer disjoint. Recompilation succeeds."
          }
        },
        "executionLane": {
          "containsRestriction": {
            "subject": "dog",
            "object": "running"
          }
        }
      }
