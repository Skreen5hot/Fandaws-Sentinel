{
  "bundle_id": "phase-c1-compilation-lifecycle",
  "bundle_version": 1,
  "authored": "2026-04-17",
  "status": "active",
  "confirmed": "2026-04-17",
  "confirmation_notes": "26/26 passing. 0 discrepancy reports. 3 transcript spot-checks clean (cascade isolation, tentative export, recovery). Two fixes applied post-transcript: tentative export filter in triple-extractor, canonical status recovery from CompilerRejected.",
  "verifies_phase": "Phase C1 \u2014 Compilation Lifecycle (Internal Machinery)",
  "locked_decisions": {
    "C-1": "Phase split: C1 (internal lifecycle) + C2 (external RECC). C1 ships first.",
    "C-2": "Retraction cascade via sourceCanonical links, not rdfs:subClassOf hierarchy.",
    "C-3": "Confidence defaults: conversational=1.0, scope-resolved=1.0, released-quarantine=0.7, imported=N/A.",
    "C-4": "TentativeGraph = boolean fandaws:tentative flag on artifact, not separate structure.",
    "C-5": "Three stale trigger scopes: single artifact, relation type, full graph.",
    "C-6_clarified": "Tier 1 bare properties carry NO RECC. RECC activates only on resolved relation types (Tier 2A or Phase D)."
  },
  "scenarios": [
    {
      "id": "stale-canonical-change-marks-stale",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Section 2.4.1 \u2014 Invalidation Markers",
        "Decision C-5 Scope 1"
      ],
      "description": "When a canonical record is updated after compilation, its execution artifact is marked Stale with invalidatedAt and invalidationReason. The artifact is not deleted \u2014 just flagged.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              {
                "id": "user:mammal",
                "canonicalLabel": "mammal",
                "parent": null
              },
              {
                "id": "user:dog",
                "canonicalLabel": "dog",
                "parent": "user:mammal",
                "compilationStatus": "Compiled"
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "utterance",
        "value": "a dog is an animal"
      },
      "expect": {
        "executionLane": {
          "artifactFor": "dog",
          "priorArtifact": {
            "compilationStatus": "Stale",
            "hasField": "fandaws:invalidatedAt",
            "hasField2": "fandaws:invalidationReason"
          },
          "currentArtifact": {
            "compilationStatus": "Compiled",
            "note": "After stale detection + recompilation, a new Compiled artifact replaces the stale one."
          }
        }
      }
    },
    {
      "id": "stale-excluded-from-export",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Rule CS-3 \u2014 Stale excluded from reasoner input"
      ],
      "description": "Stale execution artifacts are excluded from Turtle export. Only Compiled artifacts appear in the export.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              {
                "id": "user:mammal",
                "canonicalLabel": "mammal",
                "parent": null
              },
              {
                "id": "user:dog",
                "canonicalLabel": "dog",
                "parent": "user:mammal"
              },
              {
                "id": "user:fur",
                "canonicalLabel": "fur",
                "parent": null
              }
            ]
          }
        ],
        "activeScope": "user-graph-a",
        "preCondition": "Manually inject a Stale artifact for dog-has-fur into _executionLane"
      },
      "trigger": {
        "type": "export",
        "format": "turtle"
      },
      "expect": {
        "exportCheck": {
          "doesNotContainStaleArtifacts": true,
          "containsOnlyCompiled": true,
          "note": "Stale artifacts are never serialized. A consumer loading the export sees only current, Compiled artifacts."
        }
      }
    },
    {
      "id": "stale-selective-recompile-single",
      "version": 1,
      "verifies": [
        "Decision C-5 Scope 1 \u2014 Single artifact recompilation"
      ],
      "description": "Updating one canonical restriction recompiles only that restriction's artifact. Other artifacts in the execution lane are untouched \u2014 their epochs don't change.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "concepts": [
              {
                "id": "user:mammal",
                "canonicalLabel": "mammal",
                "parent": null
              },
              {
                "id": "user:dog",
                "canonicalLabel": "dog",
                "parent": "user:mammal",
                "restrictions": [
                  {
                    "verb": "has",
                    "object": "user:fur"
                  }
                ]
              },
              {
                "id": "user:cat",
                "canonicalLabel": "cat",
                "parent": "user:mammal",
                "restrictions": [
                  {
                    "verb": "has",
                    "object": "user:whiskers"
                  }
                ]
              },
              {
                "id": "user:fur",
                "canonicalLabel": "fur",
                "parent": null
              },
              {
                "id": "user:whiskers",
                "canonicalLabel": "whiskers",
                "parent": null
              },
              {
                "id": "user:hair",
                "canonicalLabel": "hair",
                "parent": null
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "updateRestriction",
        "subject": "dog",
        "oldObject": "fur",
        "newObject": "hair"
      },
      "expect": {
        "executionLane": {
          "dogRestriction": {
            "recompiled": true,
            "newObject": "hair"
          },
          "catRestriction": {
            "recompiled": false,
            "object": "whiskers",
            "epochUnchanged": true
          }
        }
      },
      "negative_assertions": [
        {
          "condition": "no collateral recompilation",
          "description": "Cat's restriction MUST NOT be recompiled when only dog's restriction changed. Scope 1 = single artifact only."
        }
      ]
    },
    {
      "id": "stale-full-recompile-bfo-change",
      "version": 1,
      "verifies": [
        "Decision C-5 Scope 3 \u2014 Full graph recompilation",
        "FANDAWS v2.1 Rule VD-6"
      ],
      "description": "BFO re-ingestion triggers full recompilation. All execution artifacts are regenerated. All epochs increment.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": [
              {
                "id": "user:dog",
                "canonicalLabel": "dog",
                "parent": "user:mammal",
                "compilationStatus": "Compiled",
                "restrictions": [
                  {
                    "verb": "has",
                    "object": "user:fur"
                  }
                ]
              },
              {
                "id": "user:mammal",
                "canonicalLabel": "mammal",
                "parent": "user:material-entity"
              },
              {
                "id": "user:material-entity",
                "canonicalLabel": "material entity",
                "parent": null,
                "isImported": true
              },
              {
                "id": "user:fur",
                "canonicalLabel": "fur",
                "parent": null
              }
            ]
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "reingestion",
        "target": "bfo"
      },
      "expect": {
        "executionLane": {
          "allArtifactsRecompiled": true,
          "allEpochsIncremented": true,
          "note": "Full recompilation: every execution artifact regenerated from scratch."
        }
      }
    },
    {
      "id": "stale-window-is-transient",
      "version": 1,
      "verifies": [
        "Decision C-5 \u2014 Stale window minimized"
      ],
      "description": "After a canonical change, the Stale state is transient \u2014 stale detection and recompilation happen in the same synchronous pass. After the pass completes, no Stale artifacts remain.",
