                    "verb": "has_part",
                    "object": "user:cell"
                  }
                ]
              },
              {
                "id": "user:material-entity",
                "canonicalLabel": "material entity",
                "parent": null,
                "isImported": true
              },
              {
                "id": "user:cell",
