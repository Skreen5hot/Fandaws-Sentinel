    {
      "id": "staging-not-in-canonical",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Section 2.2.1 \u2014 staging records not part of active model"
      ],
      "description": "Staging records are NOT in the canonical graph. They don't have skos:broader, don't participate in the concept hierarchy, don't appear in exports. They exist only in SourceAxiomGraph.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
