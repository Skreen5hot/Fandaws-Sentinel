      "trigger": {
        "type": "ingestOntology",
        "sourceOntology": "https://example.org/test-ontology",
        "classes": [
          {
            "iri": "ex:CellDivision",
            "label": "Cell Division",
            "superclass": null,
            "properties": [
              {
                "name": "has_participant",
                "range": "ex:Cell"
              }
