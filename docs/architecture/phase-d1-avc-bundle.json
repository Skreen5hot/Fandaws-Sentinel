    {
      "id": "batch-no-conversational-prompts",
      "version": 1,
      "verifies": [
        "Decision D-2 \u2014 ingestion is batch, not conversational"
      ],
      "description": "During bulk ingestion, no CC Path A/B prompts fire. No MachineSignal emitted. Violations go to quarantine or PendingHumanResolution \u2014 no interactive prompts.",
