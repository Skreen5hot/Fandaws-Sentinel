    {
      "id": "placement-promoted-has-equivalent-class",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Section 4.6 \u2014 owl:equivalentClass on canonical class records"
      ],
      "description": "A promoted canonical class record carries owl:equivalentClass linking the Fandaws IRI to the external source IRI. This is a schema-level OWL assertion, not a compiler flag.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "ingestOntology",
        "sourceOntology": "https://example.org/test-ontology",
        "classes": [
          {
            "iri": "ex:Engine",
            "label": "Engine",
            "superclass": "bfo:MaterialEntity"
          }
        ]
      },
      "expect": {
        "canonicalLane": {
          "classRecord": {
            "iriPattern": "fandaws:class/ANY_UUID/engine",
            "owlEquivalentClass": "ex:Engine",
            "sourceIRI": "ex:Engine",
            "sourceOntology": "https://example.org/test-ontology",
            "note": "Fandaws IRI \u2260 source IRI. owl:equivalentClass bridges them."
          }
        }
      },
      "negative_assertions": [
        {
          "condition": "Fandaws IRI is fresh",
          "description": "Promoted class gets a fandaws:class/ IRI, NOT the external IRI. The external IRI is referenced via owl:equivalentClass and sourceIRI."
        }
      ]
    },
    {
      "id": "blocking-phase2-blocked-by-ambiguous",
      "version": 1,
      "verifies": [
        "Decision D-4 \u2014 Phase 2 blocked by PendingHumanResolution"
      ],
      "description": "Phase 2 (property disambiguation) cannot begin while any Phase 1 class has PendingHumanResolution status. The pipeline halts after Phase 1.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "ingestOntology",
        "sourceOntology": "https://example.org/test-ontology",
        "classes": [
          {
            "iri": "ex:Engine",
            "label": "Engine",
            "superclass": "bfo:MaterialEntity"
          },
          {
            "iri": "ex:Mystery",
            "label": "Mystery",
            "superclass": null
          }
        ],
        "properties": [
          {
            "iri": "ex:has_component",
            "label": "has component",
            "domain": "ex:Engine",
            "range": "ex:Mystery"
          }
        ]
      },
      "expect": {
        "pipelineState": {
          "phase1Complete": true,
          "phase2Started": false,
          "blockedBy": "PendingHumanResolution",
          "unresolvedCount": 1,
          "unresolvedClasses": [
            "ex:Mystery"
          ]
        }
      },
      "negative_assertions": [
        {
          "condition": "phase 2 blocked",
          "description": "Pipeline MUST NOT begin property disambiguation while any Phase 1 class is PendingHumanResolution."
        }
      ]
    },
