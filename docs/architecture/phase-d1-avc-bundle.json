    {
      "id": "placement-human-resolves-ambiguous",
      "version": 1,
      "verifies": [
        "Decision D-4 \u2014 PendingHumanResolution resolved"
      ],
      "description": "Human selects BFO placement for an ambiguous class. Class is promoted to canonical with the selected placement.",
