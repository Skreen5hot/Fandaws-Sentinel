      "id": "placement-multiple-candidates-ambiguous",
      "version": 1,
      "verifies": [
        "Decision D-7 \u2014 multiple placements with similar confidence \u2192 Ambiguous"
      ],
      "description": "External class has properties suggesting both MaterialEntity and Process with similar confidence. PlacementAmbiguous \u2014 human must choose.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "ingestOntology",
        "sourceOntology": "https://example.org/test-ontology",
        "classes": [
          {
            "iri": "ex:Reaction",
            "label": "Reaction",
            "superclass": null,
            "properties": [
              {
                "name": "has_participant",
                "range": "bfo:MaterialEntity"
              },
              {
                "name": "occurs_at",
                "range": "bfo:TemporalRegion"
              }
            ],
            "note": "Properties suggest Process (has_participant, occurs_at) but label is ambiguous (chemical reaction vs emotional reaction)"
          }
        ]
      },
      "expect": {
        "stagingRecords": {
          "record": {
            "candidateStatus": "PlacementAmbiguous",
            "normalizationStatus": "PendingHumanResolution"
          }
        }
      }
