      "description": "External class with explicit rdfs:subClassOf bfo:MaterialEntity \u2192 PlacementConfirmed with high confidence (\u22650.9). Auto-promoted to canonical.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
