            "note": "has_participant with Cell (MaterialEntity) suggests Process placement"
          }
        ]
      },
      "expect": {
        "stagingRecords": {
          "record": {
            "placementJustification": "ANY_NONEMPTY_STRING",
            "note": "Placement sandbox evaluated heuristics and produced a confidence-scored result. Disjointness check ran against existing graph."
          }
        }
      }
