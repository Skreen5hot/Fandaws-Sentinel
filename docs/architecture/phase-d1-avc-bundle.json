            "label": "Engine",
            "superclass": "bfo:MaterialEntity"
          }
        ]
      },
      "expect": {
        "sourceAxiomGraph": {
          "allowedTypes": [
            "CandidateClass",
            "CandidateRelation",
            "QuarantineRecord",
            "RawSourceAxiom"
          ],
          "noOtherTypes": true
        }
      }
    },
    {
      "id": "placement-explicit-superclass-confirmed",
      "version": 1,
      "verifies": [
        "Decision D-3 \u2014 explicit BFO superclass heuristic",
        "Decision D-7 \u2014 \u22650.7 single = Confirmed"
