{
  "bundle_id": "phase-d1-pipeline-class-placement",
  "bundle_version": 1,
  "authored": "2026-04-17",
  "status": "awaits_implementation",
  "verifies_phase": "Phase D1 \u2014 Ingestion Pipeline Infrastructure + Class Placement",
  "depends_on": "Phase C2 (quarantine store, RECC, provenance authority required)",
  "locked_decisions": {
    "D-1": "Phase split: D1 (pipeline + class placement) + D2 (disambiguation + consistency). D1 ships first.",
    "D-2": "Ingestion pipeline is batch, not conversational. No interactive prompts. Violations \u2192 quarantine or PendingHumanResolution.",
    "D-3": "Class placement sandbox: JavaScript validation. Heuristic rules return placement + confidence + justification.",
    "D-4": "Blocking rule: Phase N+1 cannot begin while Phase N has PendingHumanResolution items.",
    "D-5": "Ingestion session records: permanent, never deleted (VD-5).",
    "D-6": "Candidate staging records: CandidateClass shape with source metadata.",
    "D-7": "Placement thresholds: >=0.7 single (or delta >=0.15 over runner-up) = Confirmed, >=0.7 with delta <0.15 = Ambiguous, <0.7 = Ambiguous, none = Rejected. Delta is tunable parameter.",
    "clarification_rename": "_quarantineStore renamed to _sourceAxiomGraph per VD-1 alignment.",
    "clarification_bfo": "BFO re-ingestion auto-re-evaluates all placements. Only classes dropping below 0.7 go to PendingHumanResolution."
  },
  "scenarios": [
    {
      "id": "session-created-with-metadata",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Section 5.9.1 \u2014 IngestionSession",
        "Decision D-5"
      ],
      "description": "Starting an ingestion session creates an IngestionSession record with source ontology, start timestamp, and initial counters at zero.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "startIngestionSession",
        "sourceOntology": "https://example.org/cco/1.4",
        "autoMergeThreshold": 0.85
      },
      "expect": {
        "session": {
          "exists": true,
          "sourceOntology": "https://example.org/cco/1.4",
          "sessionStartedAt": "ANY_ISO_DATETIME",
          "sessionCompletedAt": null,
          "classesIngested": 0,
          "autoMergeThreshold": 0.85
        }
      }
    },
    {
      "id": "session-retained-permanently",
      "version": 1,
      "verifies": [
        "FANDAWS v2.1 Rule VD-5 \u2014 sessions never deleted"
      ],
      "description": "After a completed ingestion session with all items resolved, the session record remains in the Canonical Lane. It is never deleted.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a",
        "completedSessions": [
          {
            "sessionId": "fandaws:session/old",
            "sourceOntology": "https://example.org/old-ontology",
            "sessionCompletedAt": "2026-01-01T00:00:00Z",
            "classesIngested": 5,
            "classesPlaced": 5
          }
        ]
      },
      "trigger": {
        "type": "querySessions"
      },
      "expect": {
        "sessions": {
          "count": "ANY_GTE(1)",
          "containsSession": "fandaws:session/old",
          "note": "Old completed session still present. VD-5: never deleted."
        }
      }
    },
    {
      "id": "session-tracks-counts",
      "version": 1,
      "verifies": [
        "Decision D-5 \u2014 session tracks counts per phase"
      ],
      "description": "After Phase 1 completes, the session record reflects accurate counts: classesIngested, classesPlaced, classesAmbiguous, classesRejected.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
            "concepts": []
          }
        ],
        "activeScope": "user-graph-a"
      },
      "trigger": {
        "type": "ingestOntology",
        "sourceOntology": "https://example.org/test-ontology",
        "classes": [
          {
            "iri": "ex:Engine",
            "label": "Engine",
            "superclass": "bfo:MaterialEntity"
          },
          {
            "iri": "ex:Wheel",
            "label": "Wheel",
            "superclass": "bfo:MaterialEntity"
          },
          {
            "iri": "ex:Mystery",
            "label": "Mystery",
            "superclass": null
          }
        ]
      },
      "expect": {
        "session": {
          "classesIngested": 3,
          "classesPlaced": "ANY_GTE(2)",
          "note": "Engine and Wheel have explicit BFO superclass \u2192 PlacementConfirmed. Mystery has no superclass \u2192 PlacementAmbiguous or Rejected."
        }
      }
    },
    {
      "id": "session-completion-timestamp",
      "version": 1,
      "verifies": [
        "Decision D-5 \u2014 session completion recorded"
      ],
      "description": "When all phases of an ingestion session complete, sessionCompletedAt is set and compilationEpochAtCompletion records the current epoch.",
      "setup": {
        "scopes": [
          {
            "scopeType": "user",
            "graphId": "user-graph-a",
            "graphVersion": "1.0.0",
            "bfoIngested": true,
