          {
            "iri": "ex:Engine",
            "label": "Engine",
            "superclass": "bfo:MaterialEntity"
          }
        ]
      },
      "expect": {
        "stagingRecords": {
          "record": {
            "candidateStatus": "PlacementConfirmed",
            "placementConfidence": "ANY_GTE(0.9)",
            "placementJustification": "ANY_NONEMPTY_STRING"
          }
        },
        "canonicalLane": {
          "classRecord": {
            "exists": true,
            "label": "Engine",
