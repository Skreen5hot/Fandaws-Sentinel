        "classes": [
          {
            "iri": "ex:Engine",
            "label": "Engine",
            "superclass": "bfo:MaterialEntity"
          }
        ],
        "stopAfterStaging": true
      },
      "expect": {
        "stagingRecords": {
          "candidateClassCount": 1
        },
        "canonicalLane": {
          "conceptExists_Engine": false,
          "note": "Engine is staged, not yet evaluated. Not in canonical."
