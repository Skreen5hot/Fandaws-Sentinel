  {
    "id": "conv-weakening-reclassifies",
    "note": "Weakening: 'dog is an animal' when dog→mammal→animal reclassifies dog directly under animal. No inherited properties to lose in this fixture, so the consequence prompt does not fire and the reclassification proceeds. Per the consequence-aware spec, transitive redundancy is NOT idempotency — it is a weakening request.",
    "turns": [
      {
        "utterance": "An animal is an organism",
        "options": {},
        "expect": { "success": true, "conceptCount": 2 }
      },
      {
        "utterance": "A mammal is an animal",
        "options": {},
        "expect": { "success": true, "conceptCount": 3 }
      },
      {
        "utterance": "A dog is a mammal",
        "options": {},
        "expect": {
          "success": true,
          "conceptCount": 4,
          "concepts": { "dog": { "parent": "mammal" } }
        }
      },
      {
        "utterance": "A dog is an animal",
        "options": { "reclassificationConfirmed": "move" },
        "expect": {
          "success": true,
          "conceptCount": 4,
          "concepts": { "dog": { "parent": "animal" } }
        }
      }
    ]
  },
